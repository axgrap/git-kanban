#!/bin/bash
# git-kanban: Minimal POSIX shell Kanban board manager for Markdown boards in README.md
#
# Usage: git kanban [--lanes] [--help]

# Configuration
KANBAN_FILE="${README_FILE:-README.md}"
IGNORE_PREFIX="kanban:"
MAX_ITER=200
DEBUG="${DEBUG:-0}"

# Debug logging
debug() {
  if [ "$DEBUG" = "1" ]; then
    echo "[DEBUG] $*" >&2
  fi
}

# Show help
show_help() {
  cat <<EOF
Usage: git kanban [OPTIONS]

Options:
  --lanes    Output TSV with lane_index, lane_name, ticket_index, ticket_text, owner
  --help     Show this help message
  --debug    Enable debug logging (or set DEBUG=1)
  (no args)  Launch interactive TUI

Environment:
  README_FILE    Path to README file (default: README.md)

Description:
  Manage a Markdown Kanban board in README.md with an interactive TUI.
  Use --lanes to output ticket ownership inferred from git blame history.
  Only commits with subject lines beginning with "kanban:" count for ownership.

Exit codes:
  0  Success
  1  Error (missing file, no board found, etc.)
EOF
}

# Infer owner for a ticket line using iterative git blame
# Args: $1=file, $2=line_number
# Returns: owner name or empty string
blame_owner_for_line() {
  local file="$1"
  local lineno="$2"
  
  # Check if we're in a git repository
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    debug "Not in a git repository"
    echo ""
    return
  fi

  # Check if file is tracked
  if ! git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
    debug "File $file is not tracked by git"
    echo ""
    return
  fi

  # Create temporary ignore file
  local ignore_file
  ignore_file=$(mktemp)
  trap "rm -f '$ignore_file'" RETURN

  # Check if git supports --ignore-revs-file
  local ignore_flag=""
  if git blame --help 2>&1 | grep -q -- '--ignore-revs-file'; then
    ignore_flag="--ignore-revs-file"
    debug "Git supports --ignore-revs-file"
  else
    debug "Git does not support --ignore-revs-file (requires Git 2.23+)"
  fi

  local iteration=0
  local prev_sha=""
  
  while [ $iteration -lt $MAX_ITER ]; do
    iteration=$((iteration + 1))
    
    # Run git blame
    local blame_cmd="git blame -L $lineno,$lineno --porcelain"
    if [ -n "$ignore_flag" ] && [ -s "$ignore_file" ]; then
      blame_cmd="$blame_cmd $ignore_flag '$ignore_file'"
    fi
    blame_cmd="$blame_cmd -- '$file'"
    
    debug "Running: $blame_cmd"
    local blame_output
    if ! blame_output=$(eval $blame_cmd 2>&1); then
      debug "Git blame failed: $blame_output"
      echo ""
      return
    fi

    # Extract SHA and author from porcelain output
    local sha
    sha=$(echo "$blame_output" | head -1 | awk '{print $1}')
    
    if [ -z "$sha" ] || [ "$sha" = "0000000000000000000000000000000000000000" ]; then
      debug "No valid SHA found in blame output"
      echo ""
      return
    fi

    # Detect infinite loop
    if [ "$sha" = "$prev_sha" ]; then
      debug "Same SHA encountered twice: $sha"
      echo ""
      return
    fi
    prev_sha="$sha"

    # Get commit subject
    local subject
    subject=$(git show -s --format=%s "$sha" 2>/dev/null || echo "")
    
    debug "SHA: $sha, Subject: $subject"

    # Check if subject starts with ignore prefix (case-insensitive)
    if echo "$subject" | grep -iq "^${IGNORE_PREFIX}"; then
      # This is a kanban commit - get the author
      local author
      author=$(git show -s --format=%an "$sha" 2>/dev/null || echo "")
      debug "Found kanban commit by: $author"
      echo "$author"
      return
    else
      # Not a kanban commit - add to ignore list and retry
      debug "Not a kanban commit, ignoring SHA: $sha"
      echo "$sha" >> "$ignore_file"
      
      # If we don't have --ignore-revs-file support, we can't continue
      if [ -z "$ignore_flag" ]; then
        debug "Cannot continue without --ignore-revs-file support"
        echo ""
        return
      fi
    fi
  done

  debug "Max iterations ($MAX_ITER) reached"
  echo ""
}

# Find Kanban board bounds in README.md
# Returns: "start_line end_line" or exits with error
find_board_bounds() {
  if [ ! -f "$KANBAN_FILE" ]; then
    echo "Error: $KANBAN_FILE not found" >&2
    exit 1
  fi

  # Find start: first H2 with "Kanban" after a "---" line
  local start_line
  start_line=$(awk '/^---$/ {f=1} f && /^## .*[Kk]anban/ {print NR; exit}' "$KANBAN_FILE")
  
  if [ -z "$start_line" ]; then
    echo "Error: Kanban board section not found in $KANBAN_FILE" >&2
    exit 1
  fi

  # Find end: next H2 or EOF
  local end_line
  end_line=$(awk -v s="$start_line" 'NR > s && /^## / {print NR-1; exit}' "$KANBAN_FILE")
  
  if [ -z "$end_line" ]; then
    # No next H2, use EOF
    end_line=$(wc -l < "$KANBAN_FILE")
  fi

  echo "$start_line $end_line"
}

# Output lanes in TSV format
output_lanes() {
  local bounds
  bounds=$(find_board_bounds)
  local start_line end_line
  read -r start_line end_line <<< "$bounds"
  
  debug "Board bounds: $start_line to $end_line"

  # Parse lanes and tickets
  local lane_index=-1
  local current_lane=""
  local ticket_index
  
  while IFS= read -r line; do
    # Detect lane (bolded text)
    if echo "$line" | grep -qE '^[[:space:]]*\*\*[^*]+\*\*[[:space:]]*$'; then
      # Extract lane name
      current_lane=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^\*\*//;s/\*\*$//')
      lane_index=$((lane_index + 1))
      ticket_index=0
      debug "Found lane $lane_index: $current_lane"
      continue
    fi
    
    # Detect ticket (checked or unchecked)
    if echo "$line" | grep -qE '^- \[([ x])\]'; then
      if [ -z "$current_lane" ]; then
        debug "Warning: ticket found before any lane"
        continue
      fi
      
      # Extract ticket text
      local ticket_text
      ticket_text=$(echo "$line" | sed 's/^- \[[x ]\] //')
      
      # Get line number in file for git blame
      local file_line_num
      file_line_num=$(awk -v s="$start_line" -v text="$line" 'NR >= s && $0 == text {print NR; exit}' "$KANBAN_FILE")
      
      # Infer owner
      local owner=""
      if [ -n "$file_line_num" ]; then
        owner=$(blame_owner_for_line "$KANBAN_FILE" "$file_line_num")
      fi
      
      debug "Ticket $ticket_index in lane $lane_index: $ticket_text (owner: $owner)"
      
      # Output TSV line
      printf "%d\t%s\t%d\t%s\t%s\n" "$lane_index" "$current_lane" "$ticket_index" "$ticket_text" "$owner"
      
      ticket_index=$((ticket_index + 1))
    fi
  done < <(sed -n "${start_line},${end_line}p" "$KANBAN_FILE")
}

# Parse command-line arguments
case "${1:-}" in
  --lanes)
    output_lanes
    exit 0
    ;;
  --debug)
    DEBUG=1
    shift
    exec "$0" "$@"
    ;;
  --help|-h)
    show_help
    exit 0
    ;;
  "")
    # No arguments - run TUI (continue with rest of script)
    ;;
  *)
    echo "Error: Unknown option: $1" >&2
    echo "Use --help for usage information" >&2
    exit 1
    ;;
esac

# ===== TUI Mode - Interactive Kanban Board =====

KANBAN_FILE="README.md"


if [ ! -f "$KANBAN_FILE" ]; then
  echo "Error: $KANBAN_FILE not found in current directory." >&2
  exit 1
fi

# Find Kanban board section
start_line=$(awk '/^---$/ {f=1} f && /^## .*Kanban/ {print NR; exit}' "$KANBAN_FILE")
if [ -z "$start_line" ]; then
  echo "Kanban board section not found." >&2
  exit 1
fi

# Collect all bolded lane names under Kanban board
lanes=()
lane_lines=()
while IFS=: read -r lnum lname; do
  clean_lane=$(echo "$lname" | sed 's/^ *//;s/ *$//;s/^\*\*//;s/\*\*$//')
  lanes+=("$clean_lane")
  lane_lines+=("$lnum")
done < <(awk -v s="$start_line" 'NR>=s {if ($0 ~ /^[[:space:]]*\*\*[^*]+\*\*[[:space:]]*$/) {print NR":"$0}}' "$KANBAN_FILE")
if [ ${#lanes[@]} -eq 0 ]; then
  echo "No lanes found in Kanban board." >&2
  exit 1
fi

# Parse tickets from all lanes using robust awk extraction
lane_tickets=()
for idx in "${!lanes[@]}"; do
  lnum="${lane_lines[$idx]}"
  next_lnum="${lane_lines[$((idx+1))]:-99999}"
  tickets=$(awk -v s="$((lnum+1))" -v e="$((next_lnum-1))" '
    NR < s {next}
    NR > e {exit}
    /^- \[ \]/ {sub(/^- \[ \] /, ""); print NR":"$0}
  ' "$KANBAN_FILE")
  lane_tickets+=("$tickets")
done

# Color definitions
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
MAGENTA="\033[35m"
CYAN="\033[36m"
BOLD="\033[1m"
RESET="\033[0m"
HL="\033[7m"

selected=0
# Snazzy ANSI header
while true; do
  clear
  echo -e "${CYAN}${BOLD}========================================${RESET}"
  echo -e "${MAGENTA}${BOLD}        git-kanban: TUI Board           ${RESET}"
  echo -e "${CYAN}${BOLD}========================================${RESET}"
  echo -e "${YELLOW}Use ↑/↓ arrows to select lane. Press Enter to confirm.${RESET}"
  echo ""
  options=("${BOLD}${RED}← Back/Exit${RESET}" "${BOLD}${GREEN}＋ Create lane${RESET}")
  for i in "${!lanes[@]}"; do
    options+=("${lanes[$i]}")
  done
  non_lane_options=$(( ${#options[@]} - ${#lanes[@]} ))
  for i in "${!options[@]}"; do
    if [ $i -eq $selected ]; then
      if [ $i -eq 0 ]; then
        printf "%b\n" "${HL}   ${options[$i]} ${RESET}"
      elif [ $i -eq 1 ]; then
        printf "%b\n" "${HL}${GREEN}   ${options[$i]} ${RESET}"
      else
        printf "${HL}${BLUE} %-2d ${RESET}${HL}${BOLD}|${RESET}${HL}${GREEN} %-20s ${RESET}\n" $((i-1)) "${options[$i]}"
      fi
    else
      if [ $i -eq 0 ]; then
        printf "%b\n" "   ${options[$i]} "
      elif [ $i -eq 1 ]; then
        printf "%b\n" "${GREEN}   ${options[$i]} ${RESET}"
      else
        printf "${BLUE} %-2d ${RESET}${BOLD}|${RESET}${GREEN} %-20s ${RESET}\n" $((i-1)) "${options[$i]}"
      fi
    fi
  done
  IFS= read -rsn1 key
  if [[ $key == $'\x1b' ]]; then
    IFS= read -rsn1 k1
    IFS= read -rsn1 k2
    if [[ $k1 == "[" ]]; then
      if [[ $k2 == "A" ]]; then
        ((selected--))
        [ $selected -lt 0 ] && selected=0
      elif [[ $k2 == "B" ]]; then
        ((selected++))
        [ $selected -ge ${#options[@]} ] && selected=$((${#options[@]}-1))
      fi
    fi
  elif [[ $key == "" ]]; then
    if [ $selected -eq 0 ]; then
      exit 0
    elif [ $selected -eq 1 ]; then
      # Create lane
      read -p "Enter new lane name: " new_lane
      if [ -n "$new_lane" ]; then
        board_start=$(awk '/^---$/ {f=1} f && /^## .*Kanban/ {print NR; exit}' "$KANBAN_FILE")
        board_end=$(awk -v s="$board_start" 'NR>=s && /^- \[ \]/ {last=NR} END {print last}' "$KANBAN_FILE")
        if [ -z "$board_start" ] || [ -z "$board_end" ]; then
          echo "Kanban board section not found for lane insertion." >&2
          continue
        fi
        echo "Select position for new lane:"
        for i in "${!lanes[@]}"; do
          echo "  $((i+1)). ${lanes[$i]}"
        done
        read -p "Enter lane number to position relative to: " pos_num
        if [[ "$pos_num" =~ ^[0-9]+$ ]] && [ "$pos_num" -ge 1 ] && [ "$pos_num" -le ${#lanes[@]} ]; then
          read -p "Insert above or below lane $pos_num? (a/b): " ab
          ab=${ab:-b}
          lane_label="**${lanes[$((pos_num-1))]}**"
          insert_line=$(awk -v label="$lane_label" -v s="$board_start" -v e="$board_end" 'NR>=s && NR<=e && index($0,label){print NR; exit}' "$KANBAN_FILE")
          if [ -z "$insert_line" ]; then
            echo "Lane label not found in board section. Lane will not be added."
            continue
          fi
          if [ "$ab" = "a" ]; then
            awk -v s="$board_start" -v e="$board_end" -v iline="$insert_line" -v lane="$new_lane" '{
              if (NR < s || NR > e) {print $0; next}
              if (NR == iline) {print "**" lane "**\n"; print $0; next}
              print $0
            }' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
          else
            awk -v s="$board_start" -v e="$board_end" -v iline="$insert_line" -v lane="$new_lane" '{
              if (NR < s || NR > e) {print $0; next}
              print $0
              if (NR == iline) {print "**" lane "**\n"}
            }' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
          fi
          # Recalculate lanes and lane_lines after insertion
          lanes=()
          lane_lines=()
          while IFS=: read -r lnum lname; do
            clean_lane=$(echo "$lname" | sed 's/^ *//;s/ *$//;s/^\*\*//;s/\*\*$//')
            lanes+=("$clean_lane")
            lane_lines+=("$lnum")
          done < <(awk -v s="$board_start" 'NR>=s {if ($0 ~ /^[[:space:]]*\*\*[^*]+\*\*[[:space:]]*$/) {print NR":"$0}}' "$KANBAN_FILE")
        else
          echo "Invalid lane number. Lane will not be added."
        fi
      fi
      continue
    else
      lane_num=$((selected-non_lane_options))
      src_lane="${lanes[$lane_num]}"
      break
    fi
  fi
done

# Find index of selected lane
src_idx=$lane_num
IFS=$'\n' read -rd '' -a ticket_lines <<< "${lane_tickets[$src_idx]}"

# Utility: Add a ticket to a lane
add_ticket() {
  local lane="$1"
  local ticket="$2"
  awk -v lane="$lane" -v ticket="$ticket" '
    BEGIN {added=0}
    /^\*\*.*\*\*/ {
      print $0
      if ($0 ~ "\\*\\*" lane "\\*\\*") {
        print ""
        print "- [ ] " ticket
        print ""
        added=1
      }
      next
    }
    {print $0}
    END {if (!added) print "**" lane "**\n\n- [ ] " ticket "\n"}
  ' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
}

# Utility: Remove a ticket from a lane
remove_ticket() {
  local lane="$1"
  local ticket="$2"
  awk -v lane="$lane" -v ticket="$ticket" '
    in_lane=0
    /^\*\*.*\*\*/ {
      in_lane=($0 ~ "\\*\\*" lane "\\*\\*")
      print $0
      next
    }
    in_lane && /^- \[ \] / {
      if ($0 ~ "^- \[ \] " ticket "$") next
    }
    {print $0}
  ' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
}

# Utility: Add a lane
add_lane() {
  local lane="$1"
  echo -e "\n**$lane**\n" >> "$KANBAN_FILE"
}

# Utility: Remove a lane
remove_lane() {
  local lane="$1"
  awk -v lane="$lane" '
    skip=0
    /^\*\*.*\*\*/ {
      if ($0 ~ "\\*\\*" lane "\\*\\*") {skip=1; next}
      skip=0
    }
    skip && /^- \[ \] / {next}
    !skip {print $0}
  ' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
}

# Arrow-key TUI for ticket selection as a function
select_ticket() {
  selected=0
  while true; do
    clear
    printf "%b" "${CYAN}${BOLD}========================================${RESET}\n"
    printf "%b" "${MAGENTA}${BOLD}        git-kanban: TUI Board           ${RESET}\n"
    printf "%b" "${CYAN}${BOLD}========================================${RESET}\n"
    printf "%b" "${YELLOW}Tickets in $src_lane:${RESET}\n"
    printf "%b" "${YELLOW}Use ↑/↓ arrows to select ticket. Press Enter to confirm.${RESET}\n"
    printf "%b" "\n"
    options=("← Back" "＋ Create ticket")
    for i in "${!ticket_lines[@]}"; do
      ticket_text=${ticket_lines[$i]#*:}
      options+=("$ticket_text")
    done
    for i in "${!options[@]}"; do
      if [ $i -eq $selected ]; then
        if [ $i -eq 0 ]; then
          printf "%b   %s %b\n" "$HL$BOLD$RED" "${options[$i]}" "$RESET"
        elif [ $i -eq 1 ]; then
          printf "%b   %s %b\n" "$HL$GREEN" "${options[$i]}" "$RESET"
        else
          printf "%b%2d%b|%b%-60s%b\n" "$HL$BLUE" $((i-1)) "$RESET$HL$BOLD" "$HL$GREEN" "${options[$i]}" "$RESET"
        fi
      else
        if [ $i -eq 0 ]; then
          printf "%b   %s %b\n" "$BOLD$RED" "${options[$i]}" "$RESET"
        elif [ $i -eq 1 ]; then
          printf "%b   %s %b\n" "$GREEN" "${options[$i]}" "$RESET"
        else
          printf "%b%2d%b|%b%-60s%b\n" "$BLUE" $((i-1)) "$RESET$BOLD" "$GREEN" "${options[$i]}" "$RESET"
        fi
      fi
    done
    IFS= read -rsn1 key
    if [[ $key == $'\x1b' ]]; then
      IFS= read -rsn1 k1
      IFS= read -rsn1 k2
      if [[ $k1 == "[" ]]; then
        if [[ $k2 == "A" ]]; then
          ((selected--))
          [ $selected -lt 0 ] && selected=0
        elif [[ $k2 == "B" ]]; then
          ((selected++))
          [ $selected -ge ${#options[@]} ] && selected=$((${#options[@]}-1))
        fi
      fi
    elif [[ $key == "" ]]; then
      if [ $selected -eq 0 ]; then
        return 1  # Go back to lane selection
      elif [ $selected -eq 1 ]; then
        # Create ticket
        read -p "Enter new ticket name: " new_ticket
        if [ -n "$new_ticket" ]; then
          add_ticket "$src_lane" "$new_ticket"
          # Immediately clean up Kanban board formatting ONLY within the board section
          board_start=$(awk '/^---$/ {f=1} f && /^## .*Kanban/ {print NR; exit}' "$KANBAN_FILE")
          board_end=$(awk -v s="$board_start" 'NR>=s && /^- \[ \]/ {last=NR} END {print last}' "$KANBAN_FILE")
          if [ -n "$board_start" ] && [ -n "$board_end" ]; then
            awk -v s="$board_start" -v e="$board_end" '
              NR < s {print $0; next}
              NR > e {print $0; next}
              /^\*\*.*\*\*/ {
                if (in_list) {print ""; in_list=0}
                print $0; print ""; next
              }
              /^- \[ \]/ {
                if (!in_list) {in_list=1}
                print $0
                next
              }
              /^$/ {next}
              {print $0}
              ENDFILE {
                if (in_list) {print ""; in_list=0}
              }
            ' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
          fi
          # Check for merge conflicts before committing
          if grep -qE '<<<<<<<|=======|>>>>>>>' "$KANBAN_FILE"; then
            echo "Error: Merge conflict detected in $KANBAN_FILE. Please resolve conflicts before committing." >&2
            return 1
          fi
          # Commit the change
          git add "$KANBAN_FILE"
          git commit -m "kanban: added ticket '$new_ticket' to $src_lane"
          # Immediately refresh ticket_lines from README after adding
          src_idx=$lane_num
          lane_tickets=()
          for idx in "${!lanes[@]}"; do
            lnum="${lane_lines[$idx]}"
            next_lnum="${lane_lines[$((idx+1))]:-99999}"
            tickets=$(awk -v s="$((lnum+1))" -v e="$((next_lnum-1))" '
              NR < s {next}
              NR > e {exit}
              /^- \[ \]/ {sub(/^- \[ \] /, ""); print NR":"$0}
            ' "$KANBAN_FILE")
            lane_tickets+=("$tickets")
          done
          IFS=$'\n' read -rd '' -a ticket_lines <<< "${lane_tickets[$src_idx]}"
        fi
        continue
      else
        ticket_line="${ticket_lines[$((selected-2))]}"
        SEL=${ticket_line%%:*}
        ticket=${ticket_line#*:}
        return 0  # Ticket selected
      fi
    fi
  done
}


# Track if a move is made
move_made=0
if select_ticket; then
  move_made=1
else
  # Go back to lane selection: restart script
  exec "$0"
fi

# Select destination lane




# Arrow-key TUI for destination lane selection (excluding source lane)
selected=0
while true; do
  clear
  printf "%b" "${CYAN}${BOLD}========================================${RESET}\n"
  printf "%b" "${MAGENTA}${BOLD}        git-kanban: TUI Board           ${RESET}\n"
  printf "%b" "${CYAN}${BOLD}========================================${RESET}\n"
  printf "%b" "${YELLOW}Select destination lane:${RESET}\n"
  printf "%b" "${YELLOW}Use ↑/↓ arrows to select lane. Press Enter to confirm.${RESET}\n"
  printf "%b" "\n"
  options=("← Back")
  idx=0
  lane_map=()
  for i in "${!lanes[@]}"; do
    if [ $((i+1)) -eq $lane_num ]; then
      continue  # skip source lane
    fi
    lane_map+=($i)
    options+=("${lanes[$i]}")
    ((idx++))
  done
  for i in "${!options[@]}"; do
    if [ $i -eq $selected ]; then
      if [ $i -eq 0 ]; then
        printf "%b   %s %b\n" "$HL$BOLD$RED" "${options[$i]}" "$RESET"
      else
        printf "%b%2d%b|%b%-20s%b\n" "$HL$BLUE" $i "$RESET$HL$BOLD" "$HL$GREEN" "${options[$i]}" "$RESET"
      fi
    else
      if [ $i -eq 0 ]; then
        printf "%b   %s %b\n" "$BOLD$RED" "${options[$i]}" "$RESET"
      else
        printf "%b%2d%b|%b%-20s%b\n" "$BLUE" $i "$RESET$BOLD" "$GREEN" "${options[$i]}" "$RESET"
      fi
    fi
  done
  IFS= read -rsn1 key
  if [[ $key == $'\x1b' ]]; then
    IFS= read -rsn1 k1
    IFS= read -rsn1 k2
    if [[ $k1 == "[" ]]; then
      if [[ $k2 == "A" ]]; then
        ((selected--))
        [ $selected -lt 0 ] && selected=0
      elif [[ $k2 == "B" ]]; then
        ((selected++))
        [ $selected -ge ${#options[@]} ] && selected=$((${#options[@]}-1))
      fi
    fi
  elif [[ $key == "" ]]; then
    if [ $selected -eq 0 ]; then
      # Go back to ticket selection
      break 2
    else
      dest_idx=${lane_map[$((selected-1))]}
      dest_lane="${lanes[$dest_idx]}"
      break
    fi
  fi
done









# Only move and commit if a move was made
if [ "$move_made" -eq 1 ] && [ "$src_lane" != "$dest_lane" ] && [ -n "$dest_lane" ]; then
  # Move the ticket (robust line-based logic, no extra linebreaks)
  tmpfile="${KANBAN_FILE}.tmp"
  lane_idx=0
  in_lane=0
  while IFS= read -r l; do
    if [ $lane_idx -lt ${#lanes[@]} ] && echo "$l" | grep -q "^\*\*${lanes[$lane_idx]}\*\*"; then
      in_lane=1
      echo "$l" >> "$tmpfile"
      lane_idx=$((lane_idx+1))
      continue
    fi
    if [ $in_lane -eq 1 ] && echo "$l" | grep -q '^\*\*'; then
      in_lane=0
    fi
    if [ $in_lane -eq 1 ] && echo "$l" | grep -q '^- \[ \]'; then
      if [ "${l#- \[ \] }" = "$ticket" ] && [ "$src_lane" = "${lanes[$((lane_idx-1))]}" ]; then
        continue  # skip moved ticket
      fi
      echo "$l" >> "$tmpfile"
      continue
    fi
    echo "$l" >> "$tmpfile"
  done < "$KANBAN_FILE"
  mv "$tmpfile" "$KANBAN_FILE"

  # Add to destination lane (no extra linebreaks, check off if Done)
  tmpfile="${KANBAN_FILE}.tmp"
  added=0
  ticket_box="- [ ] $ticket"
  if [[ "$dest_lane" =~ ^[Dd]one$ ]]; then
    ticket_box="- [x] $ticket"
  fi
  while IFS= read -r l; do
    echo "$l" >> "$tmpfile"
    if [ $added -eq 0 ] && echo "$l" | grep -q "^\*\*$dest_lane\*\*"; then
      added=1
      echo "$ticket_box" >> "$tmpfile"
    fi
  done < "$KANBAN_FILE"
  mv "$tmpfile" "$KANBAN_FILE"

  # Clean up Kanban board formatting ONLY within the board section
  board_start=$(awk '/^---$/ {f=1} f && /^## .*Kanban/ {print NR; exit}' "$KANBAN_FILE")
  board_end=$(awk -v s="$board_start" 'NR>=s && /^- \[ \]/ {last=NR} END {print last}' "$KANBAN_FILE")
  if [ -z "$board_start" ] || [ -z "$board_end" ]; then
    echo "Kanban board section not found for formatting." >&2
  else
    awk -v s="$board_start" -v e="$board_end" '
      NR < s {print $0; next}
      NR > e {print $0; next}
      /^\*\*.*\*\*/ {
        if (in_list) {print ""; in_list=0}
        print $0; print ""; next
      }
      /^- \[ \]/ {
        if (!in_list) {in_list=1}
        print $0
        next
      }
      /^$/ {next}
      {print $0}
      ENDFILE {
        if (in_list) {print ""; in_list=0}
      }
    ' "$KANBAN_FILE" > "$KANBAN_FILE.tmp" && mv "$KANBAN_FILE.tmp" "$KANBAN_FILE"
  fi

  # Check for merge conflicts before committing
  if grep -qE '<<<<<<<|=======|>>>>>>>' "$KANBAN_FILE"; then
    echo "Error: Merge conflict detected in $KANBAN_FILE. Please resolve conflicts before committing." >&2
    exit 1
  fi

  # Commit the change
  git add "$KANBAN_FILE"
  git commit -m "kanban: moved '$ticket' from $src_lane to $dest_lane"

  echo "Moved '$ticket' from $src_lane to $dest_lane and committed."
  exit 0
else
  exit 0
fi